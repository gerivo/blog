---
const pathname = Astro.url.pathname;
const { itemPath, itemName } = Astro.props;
const itemIsFirstPath = itemPath.split("/")[1] === pathname.split("/")[1];
---

<li
    class:list={[
        "first:mr-auto px-2 py-1",
        { "hover:underline": !itemIsFirstPath },
        { "bg-primary": itemIsFirstPath },
    ]}
>
    <a href={itemPath}>{itemName}</a>
</li>
