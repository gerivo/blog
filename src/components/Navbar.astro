---
import NavbarItem from "./NavbarItem.astro";
---

<nav
  class="fixed bg-secondary md:p-0 top-5 flex justify-between right-5 left-5 md:right-30 md:left-30"
>
  <ul class="flex flex-col sm:flex-row w-full justify-between gap-5">
    <div class="flex w-full justify-between">
      <NavbarItem itemPath="/" itemName="g;" alwaysOn />
      <NavbarItem itemPath="menu" itemName="menu" isMenu />
    </div>
    <NavbarItem itemPath="/sobre/" itemName="sobre" />
    <NavbarItem itemPath="/juegos/" itemName="juegos" />
  </ul>
</nav>

<script is:inline>
  const menu = document.getElementById("menu");
  const isMobile = mediaQuery = window.matchMedia('(width < 48rem )').matches;
  const toggleMenu = () => {
    if (!menu) return;
    // mobile => initally hidden, desktop => initially and always shown
    const isToggled = menu.getAttribute("data-toggle") ?? !isMobile;
    menu.setAttribute("data-toggle", isToggled == "true" ? "false" : "true");
    console.log(menu.getAttribute("data-toggle"));
  };

  const shouldHide = (e, toggleState) => {
    const isMenu = e.getAttribute("data-is-menu") === "true";
    const isAlwaysOn = e.getAttribute("data-always-on") === "true";

    return !isMenu && !isAlwaysOn && !toggleState;
  };

  const hideAllMenuItems = (toggleState) => {
    document.querySelectorAll("[data-is-menu]").forEach((e) => {
      if (shouldHide(e, toggleState)) {
        e.classList.add("hidden");
      } else {
        e.classList.remove("hidden");
      }
    });
  };

  if (menu) menu.onclick = toggleMenu;
  if (isMobile) hideAllMenuItems(false);

  const mutationCallback = (mutationsList) => {
    for (const mutation of mutationsList) {
      if (
        mutation.type !== "attributes" ||
        mutation.attributeName !== "data-toggle"
      ) {
        return;
      }

      hideAllMenuItems(menu.getAttribute("data-toggle") === "true");
    }
  };

  const observer = new MutationObserver(mutationCallback);
  observer.observe(menu, { attributes: true });
</script>
