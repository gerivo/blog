---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("sobre");
---

<Layout>
    <ul
        class="flex flex-col items-center min-h-100 max-h-100 w-full"
    >
        {
            entries.map((entry) => (
                <li class="hover:underline marker:content-['*'] display-list-item pl-2 hover:cursor-pointer">
                    <a href={entry.id}>{entry.data.title}</a>
                </li>
            ))
        }
    </ul>
</Layout>
