---
import List from "../components/List.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const entriesFromCollection = await getCollection("sobre");
const entries = entriesFromCollection.map((entry) => ({
    id: entry.id,
    title: entry.data.title,
}));
---

<Layout>
    {entries.length == 0 && <p>No escribí nada acá todavía</p>}
    <List items={entries} />
</Layout>
